<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>RTM.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RTM.Domain\RTM.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- StackExchange.Redis pulls Microsoft.Extensions.Logging.Abstractions transitively.
         Only Configuration.Abstractions is explicitly needed here. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.13" />
  </ItemGroup>

</Project>
